# .env Example: Copy to .env and fill in with your secrets. 
# .env is gitignored, this template is committed. Never put a real key in this file.

# Roboflow API Key:
# Go to https://app.roboflow.com/ > Settings > API Keys
ROBOFLOW_API_KEY=

# W&B API Key: optional. 
# Go to https://wandb.ai/authorize
WANDB_API_KEY=
